foreach(variable PROJECT_ROOT DIST_ROOT LAUNCHER_BINARY REBREWU_BINARY)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${variable} for release packaging")
    endif()
endforeach()
foreach(binary LAUNCHER_BINARY REBREWU_BINARY)
    if(NOT EXISTS "${${binary}}")
        message(FATAL_ERROR "Required release executable missing: ${${binary}}")
    endif()
endforeach()

set(release "${DIST_ROOT}/SplatoonPort")
file(REMOVE_RECURSE "${release}")
file(MAKE_DIRECTORY "${release}")
file(COPY "${LAUNCHER_BINARY}" "${REBREWU_BINARY}" DESTINATION "${release}")
file(COPY "${PROJECT_ROOT}/port" DESTINATION "${release}")
file(COPY "${PROJECT_ROOT}/profiles" DESTINATION "${release}")
file(COPY "${PROJECT_ROOT}/LICENSES" DESTINATION "${release}")
file(COPY "${PROJECT_ROOT}/README.md" DESTINATION "${release}")
file(MAKE_DIRECTORY "${release}/third_party")
file(COPY "${PROJECT_ROOT}/third_party/miniaudio.h" DESTINATION "${release}/third_party")

# Explicit scan prevents game dumps or generated guest source entering archives.
file(GLOB_RECURSE bundled_files LIST_DIRECTORIES false RELATIVE "${release}" "${release}/*")
foreach(relative IN LISTS bundled_files)
    get_filename_component(ext "${relative}" EXT)
    string(TOLOWER "${ext}" ext)
    if(ext MATCHES "^[.](rpx|rpl|wud|wux|bfres|szs|pack|app|tik|tmd|key|otp)$" OR
       relative MATCHES "(^|/)(Gambit_part[0-9]+[.]cpp|Gambit_data[.]cpp|Gambit_register[.]cpp)$")
        message(FATAL_ERROR "Game-specific artifact in release: ${relative}")
    endif()
endforeach()
message(STATUS "Public release bundle staged: ${release}")
